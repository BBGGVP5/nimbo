# Единые окончания строк для исходников во всех средах.
* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Бинарные зависимости и ресурсы не должны проходить текстовую нормализацию.
*.aar binary
*.jar binary
*.dat binary
*.so binary
*.dll binary
*.exe binary
*.ico binary
*.icns binary
*.png binary

# Frozen source/notices are byte-for-byte evidence bound to native build hashes.
apps/ui/src-tauri/resources/mihomo/** -text whitespace=cr-at-eol,-blank-at-eof
apps/ui/src-tauri/resources/mihomo/adapter-source/*.patch -whitespace

# Unified-patch context lines deliberately contain a leading space before tabs.
tools/native/mihomo-core/*.patch whitespace=-blank-at-eol,-space-before-tab
