/.gradle/
/.kotlin/
/build/
/app/build/
/app/libs/*.aar
/shared/build/
/iosApp/build/
/iosApp/Nimbo.xcodeproj/
/artifacts/
/.build-dependencies/
/.codex-tmp/
/tools/native/*/.build/
local.properties
*.hprof
__pycache__/
*.pyc

# Linux helper files are verified build outputs, staged per target.
/apps/ui/src-tauri/resources/helper/

# Portable Linux Mihomo outputs are rebuilt and pinned per target in CI.
