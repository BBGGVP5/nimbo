{
  "bundle": {
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "resources": [
      "resources/naive/**/*",
      "resources/awg/**/*",
      "resources/helper/linux/nimbo-svc.manifest.json",
      "resources/helper/linux/nimbo-svc.zip",
      "resources/mihomo/linux-*/nimbo-mihomo.zip",
      "resources/mihomo/linux-*/build-manifest.json",
      "resources/mihomo/linux-*/adapter-source/**/*",
      "resources/mihomo/linux-*/notices/**/*"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/nimbo-svc": "resources/helper/linux/nimbo-svc"
        }
      },
      "rpm": {
        "files": {
          "/usr/bin/nimbo-svc": "resources/helper/linux/nimbo-svc"
        }
      }
    }
  }
}
