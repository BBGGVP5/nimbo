+func (gb *GroupBase) startTask(run func()) {
+	gb.taskMu.Lock()
+	if gb.taskClosed {
+		gb.taskMu.Unlock()
+		return
+	}
+	gb.taskWG.Add(1)
+	gb.taskMu.Unlock()
+	go func() {
+		defer gb.taskWG.Done()
+		run()
 	}()
+}
+
+// Close joins bounded dial-failure workers before the session releases their
+// providers and the platform-owned TUN.
+func (gb *GroupBase) Close() error {
+	gb.taskMu.Lock()
+	if gb.taskClosed {
+		done := gb.taskCloseDone
+		gb.taskMu.Unlock()
+		<-done
+		return nil
+	}
+	gb.taskClosed = true
+	gb.taskMu.Unlock()
+	gb.taskWG.Wait()
+	close(gb.taskCloseDone)
+	return gb.Base.Close()
 }
 
