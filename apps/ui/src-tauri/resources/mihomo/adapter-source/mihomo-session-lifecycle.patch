 func (hc *HealthCheck) close() {
+	hc.lifecycleMu.Lock()
+	if hc.closed {
+		done := hc.closeDone
+		hc.lifecycleMu.Unlock()
+		<-done
+		return
+	}
+	hc.closed = true
 	hc.ctxCancel()
+	processDone := hc.processDone
+	hc.lifecycleMu.Unlock()
+	if processDone != nil {
+		<-processDone
+	}
+	hc.tasks.Wait()
+	close(hc.closeDone)
 }
 
