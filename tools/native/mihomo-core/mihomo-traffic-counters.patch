 func (m *Manager) ResetStatistic() {
+ m.proxyUpload.Store(0); m.proxyDownload.Store(0)
+ m.directUpload.Store(0); m.directDownload.Store(0)
 	m.uploadTemp.Store(0)
 	m.uploadBlip.Store(0)
 	m.uploadTotal.Store(0)
@@ -127,3 +135,24 @@
 	Connections   []*TrackerInfo `json:"connections"`
 	Memory        uint64         `json:"memory"`
 }
+
+// Nimbo aggregate route counters. No destination or completed-connection history.
+func (m *Manager) SetDirectNames(names []string) {
+ m.routeMu.Lock(); defer m.routeMu.Unlock()
+ m.directNames = make(map[string]bool, len(names))
+ for _, name := range names { m.directNames[name] = true }
+}
+func (m *Manager) isDirectChain(chain []string) bool {
+ if len(chain) == 0 { return false }
+ m.routeMu.RLock(); defer m.routeMu.RUnlock()
+ return m.directNames[chain[0]]
+}
+func (m *Manager) PushRouteUploaded(direct bool, size int64) {
+ if direct { m.directUpload.Add(size) } else { m.proxyUpload.Add(size) }
+}
+func (m *Manager) PushRouteDownloaded(direct bool, size int64) {
+ if direct { m.directDownload.Add(size) } else { m.proxyDownload.Add(size) }
+}
+func (m *Manager) RouteTotal() (proxyUp, proxyDown, directUp, directDown int64) {
+ return m.proxyUpload.Load(), m.proxyDownload.Load(), m.directUpload.Load(), m.directDownload.Load()
+}
